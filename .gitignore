# --- Local secrets and overrides ----------------------------------------
# Never commit real credentials. application.yml ships with local-only
# defaults; per-developer and per-environment values belong in these files,
# which stay untracked.
.env
.env.*
!.env.example
application-local.yml
application-local.yaml
application-local.properties
src/main/resources/application-secrets.yml
